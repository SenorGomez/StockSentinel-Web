<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><PublishAot>false</PublishAot></PropertyGroup>
  <PropertyGroup>
    <!-- Tests reference this web project: never feed their copied content back into it.
         Exclude old publish trees even when the next publish uses another destination. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;publish/**;**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="WebPush" Version="1.0.13" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" /><PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" /><PackageReference Include="MailKit" Version="4.16.0" /><PackageReference Include="AngleSharp" Version="1.9.1" />  <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
</Project>
