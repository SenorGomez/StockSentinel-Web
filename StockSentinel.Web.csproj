<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><PublishAot>false</PublishAot></PropertyGroup>
  <PropertyGroup>
    <!-- Tests reference this web project: never feed their copied content back into it.
         Exclude old publish trees even when the next publish uses another destination. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);data/**;tests/**;publish/**;**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WebPush" Version="1.0.13" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="AngleSharp" Version="1.10.0" />  
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <!-- Runtime databases, push subscriptions and VAPID private keys are never artifacts. -->
    <Content Remove="data/**" />
    <None Remove="data/**" />
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="LICENSE;THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <!-- Keep notices from the actual runtime packs alongside self-contained binaries. -->
  <Target Name="IncludeRuntimeLegalNotices" AfterTargets="ComputeFilesToPublish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_RuntimeLicense Include="%(ResolvedRuntimePack.PackageDirectory)/LICENSE.*">
        <RelativePath>legal/%(ResolvedRuntimePack.FrameworkName)/LICENSE.txt</RelativePath>
      </_RuntimeLicense>
      <_RuntimeNotice Include="%(ResolvedRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES.*">
        <RelativePath>legal/%(ResolvedRuntimePack.FrameworkName)/THIRD-PARTY-NOTICES.txt</RelativePath>
      </_RuntimeNotice>
      <ResolvedFileToPublish Include="@(_RuntimeLicense);@(_RuntimeNotice)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
  <!-- Preserve native sidecars when the SDK skips incremental bundle generation.
       Otherwise its inferred outputs can omit SQLite and publish cleanup deletes it. -->
  <Target Name="KeepNativeFilesExternal" BeforeTargets="_ComputeFilesToBundle"
          Condition="'$(PublishSingleFile)' == 'true' And '$(IncludeNativeLibrariesForSelfExtract)' != 'true' And '$(IncludeAllContentForSelfExtract)' != 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.AssetType)' == 'native'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
