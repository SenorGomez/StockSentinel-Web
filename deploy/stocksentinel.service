[Unit]
Description=StockSentinel Monitoring Dashboard
Wants=network-online.target
After=network-online.target
[Service]
Type=simple
User=stocksentinel
Group=stocksentinel
WorkingDirectory=/opt/stocksentinel
Environment=DOTNET_ENVIRONMENT=Production
EnvironmentFile=/etc/stocksentinel.env
ExecStart=/opt/stocksentinel/current/StockSentinel.Web --contentRoot /opt/stocksentinel/current --urls http://127.0.0.1:5070
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/stocksentinel/data
ProtectHome=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
